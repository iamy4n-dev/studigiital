# Expo mobile app — copy to .env and fill in values
# All variables must be prefixed EXPO_PUBLIC_ to be accessible in the bundle.

# Base URL of the FastAPI backend (no trailing slash)
# Use your machine's LAN IP (not localhost) when testing on a physical device
EXPO_PUBLIC_API_URL=http://localhost:8000

# Clerk publishable key — find it in the Clerk dashboard under API Keys
# Leave blank to use DEV_MODE bypass (no Clerk calls made)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Set to "true" to bypass the Clerk auth gate and inject a paid dev session
# Must also set DEV_MODE=true in apps/backend/.env for the API to accept requests
EXPO_PUBLIC_DEV_MODE=true
