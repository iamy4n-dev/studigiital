# FastAPI backend — copy to .env and fill in values
# Most values have safe defaults for local dev.
# For LLM calls, either set ANTHROPIC_API_KEY or switch to a local model (see LLM section below).

# Set to true to enable Swagger UI at /docs
DEBUG=true

# PostgreSQL connection string (not yet used by routes — DB schema not implemented)
DATABASE_URL=postgresql+asyncpg://localhost/studigital

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# AWS (not yet used — placeholder for S3 media uploads)
AWS_REGION=us-east-1
S3_BUCKET=studigiital-media

# Clerk — required; JWT validation is always enforced
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# ── LLM backend ───────────────────────────────────────────────────────────────
# Option A: Anthropic (default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_INFER=claude-haiku-4-5-20251001
LLM_MODEL_FREE=claude-haiku-4-5-20251001
LLM_MODEL_PAID=claude-sonnet-4-6

# Option B: Ollama (local — run `ollama serve` first, then `ollama pull llama3.2`)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_INFER=llama3.2
# LLM_MODEL_FREE=llama3.2
# LLM_MODEL_PAID=llama3.2

# Option C: LM Studio (local — start LM Studio server on port 1234)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL_INFER=<model-name-from-lm-studio>
# LLM_MODEL_FREE=<model-name-from-lm-studio>
# LLM_MODEL_PAID=<model-name-from-lm-studio>

# Option D: OpenRouter via LiteLLM (access 200+ models with one API key)
# Model IDs use the OpenRouter format: {provider}/{model-name}
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL_INFER=google/gemma-3-27b-it
# LLM_MODEL_OCR=google/gemma-3-27b-it
# LLM_MODEL_FREE=google/gemma-3-27b-it
# LLM_MODEL_PAID=anthropic/claude-sonnet-4-5
