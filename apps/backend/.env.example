# FastAPI backend — copy to .env and fill in values
# Most values have safe defaults for local dev; only ANTHROPIC_API_KEY is required to run /transform.

# Set to true to enable Swagger UI at /docs
DEBUG=true

# PostgreSQL connection string (not yet used by routes — DB schema not implemented)
DATABASE_URL=postgresql+asyncpg://localhost/studigital

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# AWS (not yet used — placeholder for S3 media uploads)
AWS_REGION=us-east-1
S3_BUCKET=studigiital-media

# Clerk — leave blank to use the no-key dev fallback (free-tier user, no JWT validation)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Set to true to bypass auth entirely and inject a paid dev session
DEV_MODE=true

# Required to call the Anthropic API (used by all LLM skills)
ANTHROPIC_API_KEY=sk-ant-...
