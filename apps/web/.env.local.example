# ── Dev mode ──────────────────────────────────────────────────────────────────
# Set to "true" to skip all auth (mirrors backend DEV_MODE=true).
# Use this when you don't have Clerk keys configured locally.
NEXT_PUBLIC_DEV_MODE=true

# FastAPI backend
# Leave empty (default) — Next.js proxies /api/v1/* to BACKEND_URL (localhost:8000).
# Only set this if the backend is on a different host than the web app.
NEXT_PUBLIC_API_URL=
# BACKEND_URL=http://localhost:8002  # server-side proxy target; check which port uvicorn is on

# ── Clerk (required when DEV_MODE is false / production) ──────────────────────
# Get keys from https://dashboard.clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
