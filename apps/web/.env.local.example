# ── Dev mode ──────────────────────────────────────────────────────────────────
# Backend no longer supports a dev-mode auth bypass (removed in PR #65).
# Keep this false and configure real Clerk keys below.
NEXT_PUBLIC_DEV_MODE=false

# FastAPI backend — all /api/v1/* calls are proxied server-side to this URL.
BACKEND_URL=http://localhost:8002

# ── Clerk (required) ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
