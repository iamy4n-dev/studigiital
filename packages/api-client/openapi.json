  "components": {
    "schemas": {
      "ActivitySummary": {
        "properties": {
          "mistakes_resolved_this_week": {
            "type": "integer",
            "title": "Mistakes Resolved This Week"
          },
          "tags_improved_this_week": {
            "type": "integer",
            "title": "Tags Improved This Week"
          }
        },
        "type": "object",
        "required": [
          "mistakes_resolved_this_week",
          "tags_improved_this_week"
        ],
        "title": "ActivitySummary"
      },
      "ArtifactOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "capture_id": {
            "type": "string",
            "title": "Capture Id"
          },
          "artifact_type": {
            "type": "string",
            "title": "Artifact Type"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "source_text": {
            "type": "string",
            "title": "Source Text"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "default": []
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "id",
          "capture_id",
          "artifact_type",
          "content",
          "created_at",
          "source_text"
        ],
        "title": "ArtifactOut"
      },
      "CaptureCreate": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
