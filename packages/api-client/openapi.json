            "title": "Raw Content"
          },
          "media_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Key"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "CaptureCreate"
      },
      "CaptureOut": {
        "properties": {
