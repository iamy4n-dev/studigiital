            "default": ""
          }
        },
        "type": "object",
        "required": [
          "skill_name",
          "cards",
          "source_summary"
        ],
        "title": "FlashcardTransformResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
