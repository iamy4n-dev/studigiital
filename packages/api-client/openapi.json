          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/FlashcardTransformResponse"
                    },
                    {
                      "$ref": "#/components/schemas/NoteTransformResponse"
                    },
                    {
                      "$ref": "#/components/schemas/QuizTransformResponse"
                    }
                  ],
                  "title": "Response Transform Capture Api V1 Captures Transform Post",
                  "discriminator": {
                    "propertyName": "skill_name",
                    "mapping": {
                      "generate_flashcard": "#/components/schemas/FlashcardTransformResponse",
                      "generate_note": "#/components/schemas/NoteTransformResponse",
                      "generate_quiz": "#/components/schemas/QuizTransformResponse"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
