        "type": "object",
        "required": [
          "id",
          "user_id",
          "mode",
          "status",
          "created_at"
        ],
        "title": "CaptureOut"
      },
      "DrillItemOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          },
          "item_type": {
            "type": "string",
            "title": "Item Type"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "source_text": {
            "type": "string",
            "title": "Source Text"
          }
