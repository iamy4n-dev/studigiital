          "streak_days": {
            "type": "integer",
            "title": "Streak Days"
          },
          "xp": {
            "type": "integer",
            "title": "Xp"
          }
        },
        "type": "object",
        "required": [
          "tags",
          "activity",
          "streak_days",
          "xp"
        ],
        "title": "MasteryResponse"
      },
